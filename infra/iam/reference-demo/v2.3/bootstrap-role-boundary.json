{
  "Version": "2012-10-17",
  "Id": "reference-demo-iam-bootstrap-boundary-v2.3",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:TagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/reference-demo/*",
        "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-cfn-*",
        "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Component": "reference-demo",
          "aws:RequestTag/Environment": "portfolio-test",
          "aws:RequestTag/Lifecycle": "ephemeral",
          "aws:RequestTag/ManagedBy": "cloudformation",
          "aws:RequestTag/Project": "steuerberater-copilot"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Component",
            "Environment",
            "ManagedBy",
            "Lifecycle"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListEntitiesForPolicy",
        "iam:ListPolicyTags",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/reference-demo/*",
        "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-cfn-*",
        "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/control-plane/reference-demo-cfn-service-role",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-cfn-service-boundary"
        },
        "StringEquals": {
          "aws:RequestTag/Component": "reference-demo",
          "aws:RequestTag/Environment": "portfolio-test",
          "aws:RequestTag/Lifecycle": "ephemeral",
          "aws:RequestTag/ManagedBy": "cloudformation",
          "aws:RequestTag/Project": "steuerberater-copilot"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Component",
            "Environment",
            "ManagedBy",
            "Lifecycle"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/control-plane/reference-demo-cfn-service-role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/control-plane/reference-demo-cfn-service-role",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-cfn-foundation-policy",
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-cfn-iam-lifecycle-policy",
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-cfn-service-policy"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetUser"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/*",
        "arn:aws:iam::<ACCOUNT_ID>:user/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:AttachUserPolicy",
        "iam:DetachRolePolicy",
        "iam:DetachUserPolicy"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/*",
        "arn:aws:iam::<ACCOUNT_ID>:user/*"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-cloudformation",
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-ecr-publisher",
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-secret-initializer",
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-verifier"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary",
        "iam:PutRolePermissionsBoundary",
        "iam:PutUserPermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/*",
        "arn:aws:iam::<ACCOUNT_ID>:user/*"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-boundary"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStacks",
      "Resource": "arn:aws:cloudformation:eu-central-1:<ACCOUNT_ID>:stack/steuerberater-copilot-reference-demo/*"
    },
    {
      "Sid": "DenyMutateBootstrapAndRuntimeRoles",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DeleteRolePermissionsBoundary",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/control-plane/reference-demo-iam-bootstrap",
        "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/reference-demo/express-infrastructure",
        "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/reference-demo/task-execution"
      ]
    },
    {
      "Sid": "DenyOperatorPoliciesOnServiceRole",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/control-plane/reference-demo-cfn-service-role",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-iam-bootstrap-*",
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-*"
          ]
        }
      }
    },
    {
      "Sid": "DenyWrongBoundaryOnServiceRole",
      "Effect": "Deny",
      "Action": "iam:PutRolePermissionsBoundary",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/control-plane/reference-demo-cfn-service-role",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": [
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-iam-bootstrap-boundary",
            "arn:aws:iam::<ACCOUNT_ID>:policy/steuerberater-copilot/control-plane/reference-demo-operator-boundary"
          ]
        }
      }
    },
    {
      "Sid": "DenyDeleteServiceRoleBoundary",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/steuerberater-copilot/control-plane/reference-demo-cfn-service-role"
    },
    {
      "Sid": "DenyMutatePrivilegedCaller",
      "Effect": "Deny",
      "Action": [
        "iam:AttachUserPolicy",
        "iam:DeleteUser",
        "iam:DeleteUserPermissionsBoundary",
        "iam:DetachUserPolicy",
        "iam:PutUserPermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:user/reference-demo-privileged-caller"
    }
  ]
}
